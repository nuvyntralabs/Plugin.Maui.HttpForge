<Project>
  <!-- ProjectReference does not flow OutputItemType=Analyzer. Sample/tests need the generator. -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true' or $(MSBuildProjectName.EndsWith('.Sample'))">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src\Plugin.Maui.HttpForge.Generator\Plugin.Maui.HttpForge.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
