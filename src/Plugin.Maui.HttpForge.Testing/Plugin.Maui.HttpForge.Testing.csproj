<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Plugin.Maui.HttpForge.Testing</RootNamespace>
    <AssemblyName>Plugin.Maui.HttpForge.Testing</AssemblyName>
    <PackageId>Plugin.Maui.HttpForge.Testing</PackageId>
    <Title>.NET MAUI HttpForge testing stubs</Title>
    <Description>First-party stub HttpClient helpers for Plugin.Maui.HttpForge generated clients.</Description>
    <PackageTags>dotnet-maui;maui;httpforge;testing;stub;httpclient</PackageTags>
    <Authors>Niladri</Authors>
    <Company>MauiEssentials</Company>
    <Copyright>Copyright © 2026 Niladri</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://nuvyntralabs.github.io/packages/plugin-maui-httpforge/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nuvyntralabs/Plugin.Maui.HttpForge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.1.0</Version>
    <PackageReleaseNotes>StubHttp, Route, and Reply for generated HttpForge clients.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\nuget.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plugin.Maui.HttpForge\Plugin.Maui.HttpForge.csproj" />
  </ItemGroup>

</Project>
