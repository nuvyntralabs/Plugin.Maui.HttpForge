<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Plugin.Maui.HttpForge.Sample.MainPage"
             Title="HttpForge">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Plugin.Maui.HttpForge" FontSize="22" FontAttributes="Bold" />
            <Label Text="Live HTTPS calls. GET/POST use jsonplaceholder.typicode.com. Multipart uses httpbin.org."
                   TextColor="Gray" />

            <Button Text="GET /posts" Clicked="OnListClicked" />
            <Button Text="GET /posts/1" Clicked="OnGetClicked" />
            <Button Text="POST /posts" Clicked="OnCreateClicked" />
            <Button Text="Multipart POST httpbin.org/post" Clicked="OnUploadClicked" />

            <Label x:Name="StatusLabel" Text="Ready. These buttons hit the public internet." FontSize="13" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
